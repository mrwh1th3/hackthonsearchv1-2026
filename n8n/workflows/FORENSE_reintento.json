                "conditions": [
                  {
                    "id": "c_contradiccion",
                    "leftValue": "={{ $('Validar intento').first().json.motivo }}",
                    "rightValue": "contradiccion",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "contradiccion"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        660,
        0
