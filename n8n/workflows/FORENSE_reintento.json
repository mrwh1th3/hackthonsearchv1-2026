    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Si la única expansión del cluster ya se usó, se registra el límite y el reintento sigue SIN expandir (07 §3).\nWITH ev AS (\n  SELECT forense.log(\n           p_caso => $1::uuid, p_agente => 'sistema', p_tipo => 'presupuesto_agotado',\n           p_payload => $2::jsonb, p_corrida => $3::uuid)\n)\nSELECT $1::uuid AS caso_id, $4::text[] AS autores, false AS expandido,\n       'cuota_expansion_agotada'::text AS limitacion FROM ev",
        "options": {
          "queryReplacement": "={{ $('Validar intento').first().json.caso_id }}, ={{ JSON.stringify({ alcance: 'expansion', intento: $('Validar intento').first().json.intento }) }}, ={{ $('Validar intento').first().json.corrida_id }}, ={{ `{${($json.autores ?? []).join(\",\")}}` }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1320,
        280
      ],
      "name": "Registrar límite de expansión",
      "credentials": {
