{
  "name": "FORENSE_reintento",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "name": "Entrada reintento"
    },
    {
      "parameters": {
        "jsCode": "// 03: máximo dos reintentos forenses por caso. El padre ya hizo el claim\n// (UPDATE ... WHERE n_reintentos < 2): aquí NO se incrementa nada.\nconst x = $input.first().json;\nconst intento = Number(x.intento);\nif (![1, 2].includes(intento)) throw new Error(`intento fuera de rango: ${x.intento}`);\nif (!x.caso_id) throw new Error('caso_id obligatorio');\nconst motivo = x.motivo ?? null;\nconst MOTIVOS = ['evidencia_insuficiente', 'cadena_incompleta', 'defensa_no_considerada', 'evidencia_invalida', 'contradiccion'];\nif (!MOTIVOS.includes(motivo)) throw new Error(`motivo no tipificado: ${motivo}`);\nconst objetivo = x.objetivo ?? null;\nif (!objetivo || (typeof objetivo === 'string' && objetivo.trim() === '')) {\n  throw new Error('objetivo vacío: un reintento sin objetivo concreto es otra ronda 1');\n}\nconst salida = { caso_id: x.caso_id, intento, motivo, objetivo, corrida_id: x.corrida_id ?? null, cluster_id: x.cluster_id ?? null };\nreturn [{ json: salida }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "name": "Validar intento"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Conserva caso, historial y versión de contexto (17 §3): el reintento no reconstruye el cluster.\n-- version_contexto y la cuota de expansión viven en el CLUSTER, no en el\n-- caso (001): el reintento conserva la versión vigente, no la reinicia.\nSELECT c.id AS caso_id, c.corrida_id, c.cluster_id, c.nivel, c.n_reintentos,\n       c.tool_calls, c.presupuesto_agotado,\n       k.version_contexto, k.expandido AS expansiones_usadas,\n       $2::int AS intento, $3::text AS motivo, $4::jsonb AS objetivo\n  FROM forense.casos c\n  LEFT JOIN forense.clusters k ON k.corrida_id = c.corrida_id AND k.id = c.cluster_id\n WHERE c.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $('Validar intento').first().json.caso_id }}, ={{ $('Validar intento').first().json.intento }}, ={{ $('Validar intento').first().json.motivo }}, ={{ JSON.stringify($json.objetivo) }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        440,
        0
      ],
      "name": "Cargar caso vigente",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c_evidencia_insuficiente",
                    "leftValue": "={{ $('Validar intento').first().json.motivo }}",
                    "rightValue": "evidencia_insuficiente",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "evidencia_insuficiente"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c_cadena_incompleta",
                    "leftValue": "={{ $('Validar intento').first().json.motivo }}",
                    "rightValue": "cadena_incompleta",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
