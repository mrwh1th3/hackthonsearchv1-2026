        "query": "-- Ronda 2 con intento 1|2 y la version_contexto vigente; las señales nuevas se enlazan a las previas y la historia se conserva. DEPENDE de forense-db.\nSELECT * FROM forense.crear_tareas_revision($1::uuid, $2::int, $3::text[], $4::jsonb)",
        "options": {
          "queryReplacement": "={{ $('Validar intento').first().json.caso_id }}, ={{ $('Validar intento').first().json.intento }}, ={{ `{${($json.autores ?? []).join(\",\")}}` }}, ={{ $('Validar intento').first().json.objetivo }}"
