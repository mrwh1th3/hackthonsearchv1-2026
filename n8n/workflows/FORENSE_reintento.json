        "query": "-- Solo para cadena_incompleta y solo si queda la cuota. DEPENDE de forense-db.\nSELECT * FROM forense.expandir_cluster_reintento($1::uuid, $2::jsonb)",
        "options": {
          "queryReplacement": "={{ $('Validar intento').first().json.caso_id }}, ={{ $('Validar intento').first().json.objetivo }}"
