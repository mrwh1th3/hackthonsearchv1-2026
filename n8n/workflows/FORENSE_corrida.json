      "name": "Armar clusters",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Cola COMPLETA ordenada por score; el límite de 4 activos lo impone el nodo siguiente, no este SELECT.\nSELECT k.id AS cluster_id, k.corrida_id, k.score, k.estado,\n       $2::uuid AS investigacion_id, $3::text AS idempotency_key\n  FROM forense.clusters k\n WHERE k.corrida_id = $1::uuid\n ORDER BY k.score DESC NULLS LAST, k.id",
        "options": {
          "queryReplacement": "={{ $('Validar e idempotencia').first().json.corrida_id }}, ={{ $('Validar e idempotencia').first().json.investigacion_id }}, ={{ $('Validar e idempotencia').first().json.idempotency_key }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1320,
        0
      ],
      "name": "Clusters por score",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 17 §2: el límite propio de DB controla ocho pasos y CUATRO clusters. Un\n// límite de n8n no sustituye ese control. Lo que no cabe queda EN COLA, no\n// fallido (regla 10: no se pierde la cola si se acaba el tiempo).\nconst MAX_ACTIVOS = 4;\nconst filas = $input.all().map((i) => i.json);\nconst admitidos = filas.slice(0, MAX_ACTIVOS);\nconst en_cola = filas.slice(MAX_ACTIVOS);\nreturn admitidos.map((f) => ({ json: {\n  cluster_id: f.cluster_id,\n  corrida_id: f.corrida_id,\n  investigacion_id: f.investigacion_id ?? null,\n  idempotency_key: `${f.idempotency_key}:${f.cluster_id}`,\n  admitidos: admitidos.length,\n  en_cola: en_cola.length,\n  cola_restante: en_cola.map((c) => c.cluster_id),\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "name": "Despachar hasta 4"
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "PENDIENTE_FORENSE_INVESTIGAR_CLUSTER",
          "cachedResultName": "FORENSE_investigar_cluster"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "cluster_id": "={{ $json.cluster_id }}",
            "corrida_id": "={{ $json.corrida_id }}",
            "investigacion_id": "={{ $json.investigacion_id }}",
            "idempotency_key": "={{ $json.idempotency_key }}"
          }
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1760,
        0
      ],
      "name": "Despachar cluster"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Espera SOLO los clusters admitidos y reconcilia errores, timeouts y leases. Terminar de despachar NO cierra la corrida. DEPENDE de forense-db.\nSELECT * FROM forense.estado_corrida($1::uuid)",
        "options": {
          "queryReplacement": "={{ $('Validar e idempotencia').first().json.corrida_id }}"
