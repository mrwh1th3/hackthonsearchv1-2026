      "parameters": {
        "operation": "executeQuery",
        "query": "-- DEPENDE de 004 (forense-db).\nSELECT forense.armar_clusters($1::uuid) AS clusters_armados",
        "options": {
          "queryReplacement": "={{ $('Validar e idempotencia').first().json.corrida_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1100,
