    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Pese al prefijo v_, el contrato de 05/10 es una FUNCIÓN que devuelve jsonb.\nSELECT forense.v_metricas_corrida($1::uuid) AS metricas",
        "options": {
          "queryReplacement": "={{ $('Validar e idempotencia').first().json.corrida_id }}"
