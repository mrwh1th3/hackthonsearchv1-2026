    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- `completada` con conteos completados/en cola/error y cobertura; `error` si falla antes de tener resultados utilizables.\nUPDATE forense.corridas\n   SET estado = $2::text, fin = now(), metricas = $3::jsonb\n WHERE id = $1::uuid\nRETURNING id AS corrida_id, estado, fin, metricas",
        "options": {
          "queryReplacement": "={{ $('Validar e idempotencia').first().json.corrida_id }}, ={{ $('Esperar y reconciliar').first().json.estado_final }}, ={{ JSON.stringify($json.metricas) }}"
        }
