      "name": "Espera IA"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Nivel por código determinista (regla 4): sin señales → sin_hallazgos; con señales → no_concluyente. Corta agentes vivos. No toca casos del auditor.\nSELECT c.ok, c.caso_id, c.nivel, c.regla, c.n_senales, c.n_fuera_del_determinista,\n       c.tokens_in, c.tokens_out, c.costo_usd, c.investigacion_id\n  FROM jsonb_to_record(forense.cerrar_ia_complemento(nullif(nullif($1::text, 'null'), '')::uuid))\n    AS c(ok boolean, caso_id uuid, nivel text, regla text, n_senales int,\n         n_fuera_del_determinista int, tokens_in bigint, tokens_out bigint,\n         costo_usd numeric, investigacion_id text)",
        "options": {
          "queryReplacement": "={{ ($json.caso_id) ?? 'null' }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1760,
        140
      ],
      "name": "Cerrar complemento IA",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "content": "FORENSE_ia_complemento (db/028).\n\nEXACTAMENTE 5 especialistas por investigación, después del\nauditor determinista. Tope en DB: índice único\n(investigacion_id, familia) + presupuesto por ejecución e\ninvestigación en reserve_request. El nivel lo decide código.",
        "height": 220,
