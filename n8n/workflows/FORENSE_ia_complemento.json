      "name": "Desde reconciliador"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "forense/ia_complemento",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        140
      ],
      "name": "Webhook complemento IA",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Forense Webhook"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Solo se acepta investigacion_id (uuid). Nada de roles, modelos, prompts ni\n// número de agentes: el tope de 5 y el modelo los fija la DB (db/028).\nconst x = $input.first().json;\nconst fuente = x.body && typeof x.body === 'object' ? x.body : x;\nconst id = String(fuente.investigacion_id ?? '');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {\n  throw new Error('investigacion_id ausente o no es uuid');\n}\nreturn [{ json: { investigacion_id: id.toLowerCase() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "name": "Normalizar complemento"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- DEPENDE de db/028. Idempotente: índice único (investigacion_id, familia) y caso único por investigación. Sin auditor_resultados devuelve ok=false (los 5 van SIEMPRE después).\nSELECT a.ok, a.creado, a.motivo, a.caso_id, a.cluster_id, a.corrida_id, a.investigacion_id,\n       coalesce(a.tarea_ids, '[]'::jsonb) AS tarea_ids\n  FROM jsonb_to_record(forense.abrir_ia_complemento(nullif(nullif($1::text, 'null'), '')::uuid))\n    AS a(ok boolean, creado boolean, motivo text, caso_id uuid, cluster_id uuid, corrida_id uuid,\n         investigacion_id uuid, tarea_ids jsonb)",
        "options": {
          "queryReplacement": "={{ ($json.investigacion_id) ?? 'null' }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        440,
        0
      ],
      "name": "Abrir complemento IA",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: $json.ok, creado: $json.creado, motivo: $json.motivo, caso_id: $json.caso_id, investigacion_id: $json.investigacion_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        -140
      ],
      "name": "Responder 202 complemento"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok === true && $json.creado === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        660,
        0
      ],
      "name": "¿Complemento nuevo?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Un ítem por tarea: 5 exactamente (lo garantiza abrir_ia_complemento).\nSELECT nullif(nullif($1::text, 'null'), '')::uuid AS caso_id, nullif(nullif($2::text, 'null'), '')::uuid AS cluster_id, nullif(nullif($3::text, 'null'), '')::uuid AS corrida_id,\n       nullif(nullif($4::text, 'null'), '')::uuid AS investigacion_id, (x.value #>> '{}')::uuid AS tarea_id,\n       jsonb_array_length(nullif(nullif($5::text, 'null'), '')::jsonb) AS n_tareas\n  FROM jsonb_array_elements(nullif(nullif($5::text, 'null'), '')::jsonb) x",
        "options": {
          "queryReplacement": "={{ ($json.caso_id) ?? 'null' }}, ={{ ($json.cluster_id) ?? 'null' }}, ={{ ($json.corrida_id) ?? 'null' }}, ={{ ($json.investigacion_id) ?? 'null' }}, ={{ (JSON.stringify($json.tarea_ids)) ?? 'null' }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        880,
        0
      ],
      "name": "Tareas IA",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "PENDIENTE_FORENSE_EJECUTAR_AGENTE",
          "cachedResultName": "FORENSE_ejecutar_agente"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "tarea_id": "={{ $json.tarea_id }}",
            "owner": "={{ 'ia:' + $execution.id + ':' + $json.tarea_id }}"
          }
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1100,
        0
      ],
      "name": "Despachar 5 especialistas"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Conexión corta; nunca un bucle SQL bloqueante. La barrera vence con el deadline de db/028.\nSELECT nullif(nullif($1::text, 'null'), '')::uuid AS caso_id, nullif(nullif($2::text, 'null'), '')::uuid AS investigacion_id, b.completa, b.vencida, b.faltantes\n  FROM jsonb_to_record(forense.estado_barrera(nullif(nullif($1::text, 'null'), '')::uuid, 'ia'))\n    AS b(ok boolean, completa boolean, vencida boolean, faltantes jsonb)",
        "options": {
          "queryReplacement": "={{ ($json.caso_id) ?? 'null' }}, ={{ ($json.investigacion_id) ?? 'null' }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1100,
        140
      ],
      "name": "Esperar barrera IA",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.completa || $json.vencida }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
