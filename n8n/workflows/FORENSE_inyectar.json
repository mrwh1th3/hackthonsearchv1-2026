    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Rechazo con motivo legible: la UI lo muestra en /inyecciones/[id] (21 §3.3).\nUPDATE forense.inyecciones\n   SET estado = 'rechazada', diagnostico = $2::jsonb, terminado = now()\n WHERE id = $1::uuid\nRETURNING id AS inyeccion_id, estado, diagnostico",
        "options": {
          "queryReplacement": "={{ $('Registrar inyección').first().json.inyeccion_id }}, ={{ JSON.stringify($json.diagnostico) }}"
