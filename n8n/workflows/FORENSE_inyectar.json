    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Ordena primero los clusters que contienen rfcs_afectados; el resto queda en_cola (21 §3 y regla 10 intactas). DEPENDE de 008.\nSELECT * FROM forense.clusters_por_prioridad_inyeccion($1::uuid, $2::uuid)",
        "options": {
          "queryReplacement": "={{ $json.corrida_nueva_id }}, ={{ $('Registrar inyección').first().json.inyeccion_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1320,
        0
      ],
      "name": "Clusters afectados primero",
      "credentials": {
        "postgres": {
          "name": "Forense Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 21 §3: los clusters con RFC inyectados se despachan PRIMERO; el resto\n// espera. El juez tiene que ver la reacción en segundos, sin perder la\n// corrida de referencia.\nconst MAX_ACTIVOS = 4;\nconst filas = $input.all().map((i) => i.json);\nconst afectados = filas.filter((f) => f.afectado === true);\nconst resto = filas.filter((f) => f.afectado !== true);\nconst admitidos = [...afectados, ...resto].slice(0, MAX_ACTIVOS);\nreturn admitidos.map((f) => ({ json: {\n  cluster_id: f.cluster_id,\n  corrida_id: f.corrida_id,\n  inyeccion_id: f.inyeccion_id ?? null,\n  investigacion_id: f.investigacion_id ?? null,\n  afectado: f.afectado === true,\n  idempotency_key: `inyeccion:${f.inyeccion_id}:${f.cluster_id}`,\n  afectados_total: afectados.length,\n  en_cola: Math.max(0, filas.length - admitidos.length),\n} }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "name": "Priorizar afectados"
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "PENDIENTE_FORENSE_INVESTIGAR_CLUSTER",
          "cachedResultName": "FORENSE_investigar_cluster"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "cluster_id": "={{ $json.cluster_id }}",
            "corrida_id": "={{ $json.corrida_id }}",
            "investigacion_id": "={{ $json.investigacion_id }}",
            "idempotency_key": "={{ $json.idempotency_key }}"
          }
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1760,
