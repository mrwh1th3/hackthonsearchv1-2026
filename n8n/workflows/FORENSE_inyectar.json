      "name": "Despachar afectados"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- La latencia recibida→dictamen se mide sobre los eventos persistidos, no aquí: el cierre a `completada` lo hace el agregador cuando los casos terminan (21 §3.4).\nUPDATE forense.inyecciones\n   SET estado = 'investigando', corrida_nueva_id = $2::uuid, terminado = NULL\n WHERE id = $1::uuid\nRETURNING id AS inyeccion_id, estado, corrida_nueva_id, creado",
        "options": {
          "queryReplacement": "={{ $('Registrar inyección').first().json.inyeccion_id }}, ={{ $('Recalcular pistas y clusters').first().json.corrida_nueva_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
