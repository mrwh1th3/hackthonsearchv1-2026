# Supabase (proyecto dedicado hackthon2026, ref wplsldwzpyocmwzeyarj)
SUPABASE_URL=https://wplsldwzpyocmwzeyarj.supabase.co
SUPABASE_ANON_KEY=                 # publishable/anon: solo lectura con RLS, va al navegador como NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=         # local/n8n/BFF servidor; jamás en código cliente ni logs
SUPABASE_DB_URL=                   # postgresql://... para psql y loaders remotos (coordinador)
LOCAL_DB_URL=postgresql://postgres@localhost:5432/forense   # Postgres 17 Homebrew, trust local

# n8n (instancia 2.33.7, proyecto personal, prefijo FORENSE_)
N8N_BASE=https://n8n.srv1550651.hstgr.cloud
N8N_WEBHOOK_BASE=https://n8n.srv1550651.hstgr.cloud/webhook/forense
INTERNAL_WEBHOOK_SECRET=

# Sesión demo, solo servidor
DEMO_PASSWORD=1234
SESSION_SECRET=
APP_BASE_URL=

# Credenciales de n8n, no del navegador
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic (Messages API; modelos verificados: claude-sonnet-5, claude-opus-5)
ANTHROPIC_API_KEY=

# Gemini (mini-agente AISLADO del editor de expediente, docs/22 + MANIFEST §5;
# NO es el proveedor de investigación). Va también como credencial de n8n
# "Gemini API key" (HTTP Query Auth, param `key`) — el .env no basta por sí solo.
GEMINI_API_KEY=

# Kaggle (para IBM AML)
KAGGLE_USERNAME=
KAGGLE_KEY=
